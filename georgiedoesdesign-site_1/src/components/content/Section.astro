---
interface Props {
  /** Heading shown for this section. Leave off for an untitled band. */
  title?: string;
  /** Small label above the heading, e.g. "02" or "Research" */
  eyebrow?: string;
  /** Background colour of the band */
  tone?: 'plain' | 'surface' | 'white' | 'cream';
  /** "split" = heading left, content right. "stack" = heading above content. */
  layout?: 'split' | 'stack';
  /** Anchor id so you can link to this section */
  id?: string;
  /** Reduce vertical padding */
  tight?: boolean;
}

const {
  title,
  eyebrow,
  tone = 'plain',
  layout = 'split',
  id,
  tight = false,
} = Astro.props;

const toneClass = {
  plain: 'section--plain',
  surface: 'section--card',
  white: 'section--white',
  cream: 'cream',
}[tone];
---

<section
  class:list={['section', toneClass, tight && 'section--tight']}
  id={id}
>
  <div class="page">
    <div class:list={['band', `band--${layout}`]}>
      {
        (eyebrow || title) && (
          <header class="band__head">
            {eyebrow && <p class="band__eyebrow">{eyebrow}</p>}
            {title && <h2 class="band__title">{title}</h2>}
          </header>
        )
      }
      <div class="band__body prose">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .band--split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px 64px;
    align-items: start;
  }

  .band--stack {
    display: grid;
    gap: 32px;
  }

  .band__eyebrow {
    font-size: var(--t-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 10px;
  }

  .band__title {
    font-size: var(--t-h2);
  }

  .band--split .band__head {
    position: sticky;
    top: 96px;
  }

  @media (max-width: 900px) {
    .band--split {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .band--split .band__head { position: static; }
  }
</style>
