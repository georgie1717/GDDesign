---
interface Props {
  cols?: 2 | 3 | 4;
}
const { cols = 3 } = Astro.props;
---

<div class="stats" data-cols={cols}>
  <slot />
</div>

<style>
  .stats {
    display: grid;
    gap: 20px;
    margin: 12px 0 32px;
  }

  .stats[data-cols='2'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .stats[data-cols='3'] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .stats[data-cols='4'] { grid-template-columns: repeat(4, minmax(0, 1fr)); }

  @media (max-width: 820px) {
    .stats[data-cols='3'],
    .stats[data-cols='4'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 520px) {
    .stats[data-cols='2'],
    .stats[data-cols='3'],
    .stats[data-cols='4'] { grid-template-columns: 1fr; }
  }
</style>
