---
import Logo from './Logo.astro';
import { site } from '../site';

interface Props {
  /** "pill" = floating bar (home, about, contact). "lockup" = name badge (case studies). */
  variant?: 'pill' | 'lockup';
}
const { variant = 'pill' } = Astro.props;
---

{
  variant === 'pill' ? (
    <div class="navwrap">
      <div class="page">
        <nav class="nav" aria-label="Main">
          <a class="nav__brand" href="/" aria-label={`${site.name}, home`}>
            <Logo size={40} />
          </a>
          <ul class="nav__list">
            {site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  target={'external' in item && item.external ? '_blank' : undefined}
                  rel={'external' in item && item.external ? 'noopener noreferrer' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  ) : (
    <div class="lockupwrap">
      <div class="page">
        <a class="lockup" href="/" aria-label={`${site.name}, home`}>
          <Logo size={40} />
          <span class="lockup__text">
            <span class="lockup__name">{site.shortName}</span>
            <span class="lockup__role">{site.role}</span>
          </span>
        </a>
      </div>
    </div>
  )
}

<style>
  /* --- floating pill nav ------------------------------------------------ */
  .navwrap {
    position: sticky;
    top: 0;
    z-index: 40;
    padding-top: 20px;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: rgba(244, 242, 238, 0.86);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border: 1px solid rgba(19, 17, 16, 0.05);
    border-radius: 52px;
    padding: 10px 18px 10px 14px;
  }

  .nav__brand {
    display: inline-flex;
    line-height: 0;
    border-radius: 12px;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .nav__list li { margin: 0; }

  .nav__list a {
    font-size: var(--t-body);
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__list a:hover { color: var(--ink); }

  @media (max-width: 720px) {
    .navwrap { position: static; padding-top: 14px; }
    .nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      border-radius: var(--r-lg);
      padding: 14px 16px;
    }
    .nav__list {
      gap: 8px 18px;
      justify-content: flex-start;
    }
    .nav__list a { font-size: var(--t-sm); }
  }

  /* --- case study lockup ----------------------------------------------- */
  .lockupwrap { padding-top: 28px; }

  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .lockup__text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .lockup__name {
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--ink);
  }

  .lockup__role {
    font-size: var(--t-xs);
    font-style: italic;
    color: var(--ink-soft);
  }
</style>
