---
import { getCollection, render } from 'astro:content';
import CaseStudy from '../../layouts/CaseStudy.astro';

// Components available inside every .mdx case study
import Section from '../../components/content/Section.astro';
import Cols from '../../components/content/Cols.astro';
import CardGrid from '../../components/content/CardGrid.astro';
import Card from '../../components/content/Card.astro';
import Figure from '../../components/content/Figure.astro';
import Stats from '../../components/content/Stats.astro';
import Stat from '../../components/content/Stat.astro';
import Callout from '../../components/content/Callout.astro';
import Lead from '../../components/content/Lead.astro';

export async function getStaticPaths() {
  const all = (await getCollection('work')).filter((e) => !e.data.draft);
  const sorted = [...all].sort((a, b) => a.data.order - b.data.order);

  return sorted.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      others: sorted.filter((e) => e.id !== entry.id).slice(0, 3),
    },
  }));
}

const { entry, others } = Astro.props;
const { Content } = await render(entry);
---

<CaseStudy entry={entry} others={others}>
  <Content
    components={{
      Section,
      Cols,
      CardGrid,
      Card,
      Figure,
      Stats,
      Stat,
      Callout,
      Lead,
    }}
  />
</CaseStudy>
