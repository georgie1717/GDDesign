---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" creamTop={true}>
  <section class="nf">
    <div class="page">
      <h1>That page has moved on</h1>
      <p>
        The link may be out of date. Have a look at the work instead, or drop me
        a line.
      </p>
      <div class="nf__actions">
        <a class="btn" href="/">Back to the work</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: 96px 120px; }
  .nf h1 { margin-bottom: 20px; letter-spacing: -0.03em; max-width: 20ch; }
  .nf p {
    font-size: var(--t-body-lg);
    color: var(--ink-soft);
    max-width: 46ch;
  }
  .nf__actions { margin-top: 32px; }
</style>
