---
import Base from '../layouts/Base.astro';
import { site } from '../site';

/* ---------------------------------------------------------------------------
   Edit the text below. Everything on this page lives here, in plain text.
   --------------------------------------------------------------------------- */

const paragraphs = [
  `I'm a Product Designer based in ${site.location}, working across strategy, UX and UI. Most of my work sits where commercial goals meet real user behaviour: checkout, authentication, account and conversion flows.`,
  `I currently design for a global ecommerce brand on Shopify Plus, where I've led the redesign of checkout and authentication, rebuilt partner attribution logic, and set up the design system the site is built on.`,
  `I like problems that look like interface problems and turn out to be system problems. Mapping the whole journey, finding where it breaks, and designing something that holds up across markets and edge cases is the part I enjoy most.`,
  `Outside of product work I do web design for smaller brands, usually end to end, from wireframes through to build.`,
];

const skills = [
  {
    title: 'Product & UX',
    items: [
      'User journey and flow mapping',
      'Checkout, authentication and account design',
      'Conversion rate optimisation',
      'Usability testing and research synthesis',
    ],
  },
  {
    title: 'UI & systems',
    items: [
      'Design systems and component libraries',
      'Figma, variables and tokens',
      'Responsive and accessible interface design',
      'Prototyping and interaction design',
    ],
  },
  {
    title: 'Build & measure',
    items: [
      'Shopify and Liquid front-end development',
      'HTML, CSS and JavaScript',
      'GA4, Tag Manager and event tracking',
      'A/B testing and analytics reporting',
    ],
  },
];
---

<Base
  title="About me"
  description={`About ${site.name}, ${site.role} based in ${site.location}.`}
  creamTop={true}
>
  <section class="intro">
    <div class="page">
      <div class="intro__grid">
        <div>
          <h1 class="intro__title">About me</h1>
          <div class="intro__copy">
            {paragraphs.map((p) => <p>{p}</p>)}
          </div>
          <div class="intro__actions">
            <a class="btn" href={site.cv} target="_blank" rel="noopener noreferrer">
              Download my CV
            </a>
            <a class="btn btn--ghost" href={`mailto:${site.email}`}>Email me</a>
          </div>
        </div>
        <div class="intro__portrait">
          <img
            src="/images/georgie.jpg"
            alt={`${site.name}, ${site.role}`}
            width="612"
            height="720"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--card">
    <div class="page">
      <h2 class="skills__title">What I do</h2>
      <div class="skills">
        {skills.map((group) => (
          <div class="skills__group">
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { padding-block: 64px 88px; }

  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px 72px;
    align-items: start;
  }

  .intro__title { margin-bottom: 28px; letter-spacing: -0.03em; }

  .intro__copy p {
    font-size: var(--t-body);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 60ch;
  }

  .intro__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  .intro__portrait img {
    width: 100%;
    border-radius: var(--r-lg);
    object-fit: cover;
    aspect-ratio: 17 / 20;
  }

  .skills__title { margin-bottom: 40px; }

  .skills {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px 48px;
  }

  .skills__group h3 {
    font-size: var(--t-h4);
    margin-bottom: 16px;
    padding-bottom: 14px;
    border-bottom: 2px solid var(--accent);
  }

  .skills__group ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .skills__group li {
    font-size: var(--t-body);
    line-height: 1.45;
    color: var(--ink-soft);
    padding-block: 8px;
    border-bottom: 1px solid var(--line);
    margin: 0;
  }

  @media (max-width: 900px) {
    .intro__grid { grid-template-columns: 1fr; gap: 36px; }
    .intro__portrait { max-width: 320px; }
    .skills { grid-template-columns: 1fr; }
  }
</style>
