---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  /** Sit the image on a soft card background. Good for flat UI screens. */
  framed?: boolean;
  /** Optional intrinsic size. Adding these stops the page jumping as images load. */
  width?: number;
  height?: number;
}
const { src, alt, caption, framed = false, width, height } = Astro.props;
---

<figure class="fig">
  {
    framed ? (
      <div class="fig__frame">
        <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
      </div>
    ) : (
      <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig {
    margin: 32px 0;
  }

  .fig > img {
    width: 100%;
    height: auto;
    border-radius: var(--r-md);
  }

  .fig__frame {
    background: var(--card);
    border-radius: var(--r-md);
    padding: 24px;
  }

  .fig__frame img {
    width: 100%;
    height: auto;
    border-radius: var(--r-sm);
  }

  figcaption {
    margin-top: 12px;
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }

  @media (max-width: 720px) {
    .fig__frame { padding: 14px; }
  }
</style>
