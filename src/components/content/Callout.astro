---
interface Props {
  /** "quote" = large statement. "note" = quiet aside on a card. */
  tone?: 'quote' | 'note';
}
const { tone = 'quote' } = Astro.props;
---

<div class:list={['callout', `callout--${tone}`, 'prose']}>
  <slot />
</div>

<style>
  .callout { margin: 32px 0; }

  .callout--quote {
    border-left: 2px solid var(--accent);
    padding-left: 24px;
  }

  .callout--quote :global(p) {
    font-size: var(--t-h4);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .callout--note {
    background: var(--card);
    border-radius: var(--r-md);
    padding: 22px 26px;
  }

  .callout--note :global(p) {
    font-size: var(--t-sm);
    color: var(--ink-soft);
  }
</style>
