---
import { site } from '../site';
const year = new Date().getFullYear();
---

<footer class="foot cream" id="contact">
  <div class="page">
    <h2 class="foot__title">Get in touch?</h2>
    <a class="foot__email" href={`mailto:${site.email}`}>{site.email}</a>

    <div class="foot__rule"></div>

    <div class="foot__bottom">
      <ul class="foot__nav">
        {site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              target={'external' in item && item.external ? '_blank' : undefined}
              rel={'external' in item && item.external ? 'noopener noreferrer' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <p class="foot__copy">&copy; {year} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    padding-block: 80px 40px;
    margin-top: 0;
  }

  .foot__title {
    font-size: var(--t-h1);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }

  .foot__email {
    display: inline-block;
    font-size: var(--t-h3);
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .foot__email:hover { border-bottom-color: var(--ink); }

  .foot__rule {
    height: 1px;
    background: var(--line);
    margin-top: 56px;
  }

  .foot__bottom {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding-top: 26px;
  }

  .foot__nav {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .foot__nav li { margin: 0; }

  .foot__nav a {
    font-size: var(--t-body);
    color: var(--ink-soft);
    text-decoration: none;
  }

  .foot__nav a:hover { color: var(--ink); }

  .foot__copy {
    margin: 0;
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }

  @media (max-width: 720px) {
    .foot { padding-block: 56px 32px; }
    .foot__email { font-size: var(--t-h4); }
    .foot__rule { margin-top: 36px; }
    .foot__nav { gap: 10px 18px; }
    .foot__nav a { font-size: var(--t-sm); }
  }
</style>
