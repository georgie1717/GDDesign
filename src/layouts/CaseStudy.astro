---
import Base from './Base.astro';
import WorkCard from '../components/WorkCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  others: CollectionEntry<'work'>[];
}

const { entry, others } = Astro.props;
const { title, category, summary, intro, meta, hero, thumbnail } = entry.data;
---

<Base
  title={title}
  description={summary}
  navVariant="lockup"
  creamTop={true}
  ogImage={hero ?? thumbnail}
>
  <!-- ================= hero ================= -->
  <header class="hero">
    <div class="page">
      <div class="hero__grid">
        <div class="hero__text">
          <span class="pill hero__pill">{category}</span>
          <h1 class="hero__title">{title}</h1>

          {intro.length > 0 && (
            <div class="hero__intro">
              {intro.map((para) => <p>{para}</p>)}
            </div>
          )}

          {meta.length > 0 && (
            <dl class="metalist">
              {meta.map((row) => (
                <div class="metalist__row">
                  <span class="metalist__label">{row.label}:</span>{' '}
                  <span>{row.value}</span>
                </div>
              ))}
            </dl>
          )}
        </div>

        {hero && (
          <div class="hero__media">
            <img src={hero} alt={`${title} preview`} />
          </div>
        )}
      </div>
    </div>
  </header>

  <!-- ================= body ================= -->
  <article class="body">
    <slot />
  </article>

  <!-- ================= more work ================= -->
  {others.length > 0 && (
    <section class="section section--plain more">
      <div class="page">
        <h2 class="more__title">Read more of my case studies</h2>
        <div class="more__grid">
          {others.map((other) => (
            <WorkCard
              href={`/p/${other.id}/`}
              title={other.data.title}
              category={other.data.category}
              thumbnail={other.data.thumbnail}
              year={other.data.year}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .hero {
    padding-block: 64px 96px;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px 64px;
    align-items: start;
  }

  .hero__pill {
    margin-bottom: 22px;
  }

  .hero__title {
    letter-spacing: -0.025em;
    margin-bottom: 26px;
  }

  .hero__intro {
    margin-bottom: 26px;
  }

  .hero__intro p {
    font-size: var(--t-body);
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .hero__media img {
    width: 100%;
    border-radius: var(--r-md);
    box-shadow: 0 30px 60px -40px rgba(19, 17, 16, 0.4);
  }

  .body :global(.section:first-child) {
    border-top-left-radius: var(--r-xl);
    border-top-right-radius: var(--r-xl);
  }

  .more__title {
    font-size: var(--t-h3);
    margin-bottom: 36px;
  }

  .more__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 1000px) {
    .more__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; gap: 36px; }
    .hero { padding-block: 40px 64px; }
  }

  @media (max-width: 640px) {
    .more__grid { grid-template-columns: 1fr; }
  }
</style>
